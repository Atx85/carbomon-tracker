{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Food (nutrition per 100 g; energy in kcal, macros in g, minerals and cholesterol in mg)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "caloriesPer100g",
    "proteinPer100g",
    "carbsPer100g",
    "fatPer100g"
  ],
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 500,
      "minLength": 1,
      "pattern": "\\S"
    },
    "brand": {
      "type": "string",
      "maxLength": 500
    },
    "nutritionSource": {
      "type": "string",
      "maxLength": 2000
    },
    "caloriesPer100g": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "proteinPer100g": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "carbsPer100g": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "fatPer100g": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "fiberPer100g": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "sugarPer100g": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "sodiumMgPer100g": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000
    },
    "potassiumMgPer100g": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000
    },
    "calciumMgPer100g": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000
    },
    "ironMgPer100g": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000
    },
    "cholesterolMgPer100g": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100000
    }
  }
}
